# Modèle du fichier .env : copier en .env et remplacer les valeurs.
# Le .env réel n'est jamais commité (il est dans .gitignore).

# Clé que les clients envoient dans l'en-tête X-API-Key.
# Générer une valeur aléatoire : uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-moi

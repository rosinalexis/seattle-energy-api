# Modèle du fichier .env : copier en .env et remplacer les valeurs « change-moi ».
# Le .env réel n'est jamais commité (il est dans .gitignore).
#
# Générer une valeur aléatoire :
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# (caractères sans risque dans une URL de connexion)

# --- API -------------------------------------------------------------------------
# Clé que les clients envoient dans l'en-tête X-API-Key (32 caractères minimum).
API_KEY=change-moi

# --- PostgreSQL : compte administrateur (docker-compose, scripts create_db / load_dataset)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=seattle_energy

# --- PostgreSQL : rôle restreint de l'API (créé par scripts.create_db) ------------
API_DB_USER=api_seattle
API_DB_PASSWORD=change-moi

# --- URLs de connexion, construites à partir des valeurs ci-dessus -----------------
# 127.0.0.1 (et non localhost) : l'adresse exacte exposée par docker-compose. Sous Windows,
# localhost passe d'abord par IPv6 (::1), où la base n'écoute pas : la connexion resterait bloquée.
DATABASE_URL=postgresql+psycopg://${API_DB_USER}:${API_DB_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
DATABASE_ADMIN_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
